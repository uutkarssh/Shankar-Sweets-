// Prisma schema for Shankar Sweets & Bakery
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Fallback to local SQLite file if DATABASE_URL is not set at build time.
  // At runtime on Vercel, DATABASE_URL is set to the Turso libsql:// URL
  // and the libsql adapter (configured in src/lib/db.ts) takes over.
  url = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  items     Item[]
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Fixed price (used when weightBased is false)
  price       Float
  // Optional alternate prices (size variants like Small/Large, Half/Full)
  priceSmall  Float?
  priceLarge  Float?
  priceHalf   Float?
  priceFull   Float?
  // Weight-based pricing (sweets/bakery): per 250g / 500g / 1kg
  weightBased Boolean  @default(false)
  pricePerKg  Float?
  pricePer500 Float?
  pricePer250 Float?
  // Variant label scheme: "size" (small/large), "portion" (half/full), "weight" (250g/500g/1kg), "count" (piece), "single"
  variantType String   @default("single")
  // Inventory / display
  image       String?
  images      String?  // JSON string array of image URLs (max 5)
  rating      Float    @default(4.5)
  ratingCount Int      @default(0)
  featured    Boolean  @default(false)
  featuredOrder Int    @default(0)
  bestSeller  Boolean  @default(false)
  veg         Boolean  @default(true)
  inStock     Boolean  @default(true)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]

  @@index([categoryId])
  @@index([featured])
}

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  landmark      String?
  pincode       String
  lat           Float?
  lng           Float?
  distanceKm   Float?
  items        String   // JSON array of {itemId,name,variant,qty,price}
  subtotal     Float
  deliveryFee   Float
  discount     Float    @default(0)
  couponCode   String?
  total        Float
  paymentMethod String  // COD | UPI
  paymentStatus String  @default("PENDING") // PENDING | PAID | REJECTED | VERIFIED
  paymentScreenshot String?
  status       String   @default("PENDING") // PENDING | ACCEPTED | PREPARING | OUT_FOR_DELIVERY | DELIVERED | REJECTED
  notes        String?
  telegramMessageId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statusLogs   OrderStatusLog[]
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model RestaurantConfig {
  id            String  @id @default("singleton")
  name          String  @default("Shankar Sweets & Bakery")
  tagline       String  @default("Taste the Tradition")
  sinceYear     Int     @default(1962)
  address       String  @default("Pillar no. 27-28, Baraut, Prayagraj")
  phone1        String  @default("7618866717")
  phone2        String  @default("8423452102")
  lat           Float   @default(25.336578)
  lng           Float   @default(82.266731)
  deliveryRadiusKm Float @default(10)
  freeDeliveryThreshold Float @default(300)
  minDeliveryFee Float  @default(10)
  maxDeliveryFee Float  @default(70)
  acceptingOrders Boolean @default(true)
  offersEnabled   Boolean @default(true)
  upiId         String?
  openingTime   String  @default("08:00")
  closingTime   String  @default("22:00")
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  rating    Int      // 1-5
  comment   String?
  verified  Boolean  @default(false) // marked true if the phone has a delivered order with this item
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([customerPhone])
}

model LoyaltyAccount {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  points    Int      @default(0)
  totalSpent Float   @default(0)
  ordersCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points    Int      // positive for earned, negative for redeemed
  type      String   // EARNED | REDEEMED | BONUS
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([accountId])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String
  discountType  String   // percent | flat | free_delivery
  discountValue Float    @default(0)
  minOrder      Float    @default(0)
  categorySlug  String?
  active        Boolean  @default(true)
  maxRedemptions Int    @default(0) // 0 = unlimited
  redemptionCount Int   @default(0)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

model Address {
  id          String   @id @default(cuid())
  phone       String   // guest checkout keyed by phone
  customerId  String?  // linked to Customer if signed in
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home") // Home | Work | Other
  houseFlat  String
  streetArea String
  landmark   String?
  city       String   @default("Prayagraj")
  pincode    String
  lat        Float
  lng        Float
  distanceKm Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([phone])
}

model Customer {
  id            String   @id @default(cuid())
  supabaseUserId String  @unique
  email         String   @unique
  name          String?
  phone         String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]

  @@index([email])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String   // e.g. "Zone 1: 0-2km"
  minDistanceKm   Float    // start of zone (inclusive)
  maxDistanceKm   Float    // end of zone (exclusive, except last zone)
  minOrderValue   Float    @default(0) // minimum order for this zone (0 = no minimum)
  deliveryFee     Float    @default(0) // flat fee for this zone (0 = free)
  gradientStartFee Float?  // if set, fee is a gradient from gradientStartFee at minDistanceKm to gradientEndFee at maxDistanceKm
  gradientEndFee  Float?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@map("delivery_zones")
}
